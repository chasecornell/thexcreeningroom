{
  "entities": {
    "Movie": {
      "title": "Movie",
      "description": "A movie entry in The Screening Room dashboard",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 300,
          "description": "Title of the movie"
        },
        "year": {
          "type": "string",
          "maxLength": 10,
          "description": "Release year"
        },
        "releaseDate": {
          "type": "string",
          "maxLength": 50,
          "description": "Full release date string"
        },
        "genre": {
          "type": "string",
          "maxLength": 200,
          "description": "Movie genres"
        },
        "poster": {
          "type": "string",
          "maxLength": 1000,
          "description": "Poster image URL"
        },
        "imdbID": {
          "type": "string",
          "maxLength": 30,
          "description": "IMDb unique identifier"
        },
        "imdbRating": {
          "type": "string",
          "maxLength": 10,
          "description": "IMDb rating score"
        },
        "director": {
          "type": "string",
          "maxLength": 200,
          "description": "Director name(s)"
        },
        "plot": {
          "type": "string",
          "maxLength": 2000,
          "description": "Plot synopsis"
        },
        "runtime": {
          "type": "string",
          "maxLength": 30,
          "description": "Runtime string"
        },
        "addedBy": {
          "type": "string",
          "maxLength": 50,
          "description": "Member who added the movie"
        },
        "addedAt": {
          "type": "number",
          "description": "Timestamp when added"
        },
        "ratings": {
          "type": "object",
          "description": "Map of member name to 1-5 star rating"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional notes"
        },
        "isHotTake": {
          "type": "boolean",
          "description": "Whether this movie was submitted as a weekly hot take"
        },
        "hotTakeText": {
          "type": "string",
          "maxLength": 1000,
          "description": "The fiery spicy hot take quote/statement"
        },
        "hotTakeCreatedAt": {
          "type": "number",
          "description": "Timestamp of the hot take"
        }
      },
      "required": ["title", "addedAt"]
    },
    "HotTake": {
      "title": "HotTake",
      "description": "A weekly spicy movie opinion/take broadcasted to all curators",
      "type": "object",
      "properties": {
        "movieId": {
          "type": "string",
          "maxLength": 100,
          "description": "ID of associated movie"
        },
        "movieTitle": {
          "type": "string",
          "maxLength": 300,
          "description": "Title of the movie"
        },
        "movieYear": {
          "type": "string",
          "maxLength": 10,
          "description": "Release year"
        },
        "moviePoster": {
          "type": "string",
          "maxLength": 1000,
          "description": "Poster image URL"
        },
        "author": {
          "type": "string",
          "maxLength": 50,
          "description": "Author/curator of the hot take"
        },
        "hotTakeText": {
          "type": "string",
          "maxLength": 1000,
          "description": "The spicy opinion text"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when published"
        },
        "reactions": {
          "type": "object",
          "description": "Map of reaction emojis to arrays of member names"
        },
        "initialRating": {
          "type": "number",
          "description": "Initial star rating by author"
        }
      },
      "required": ["movieId", "movieTitle", "author", "hotTakeText", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A general chat message or discussion in The Screening Room lounge",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 2000,
          "description": "Message content"
        },
        "author": {
          "type": "string",
          "maxLength": 50,
          "description": "Author of the message"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when message was created"
        },
        "parentId": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional parent message ID for threaded reply"
        },
        "gifUrl": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional attached GIF image URL"
        },
        "likes": {
          "type": "array",
          "description": "List of member names who liked this message"
        },
        "dislikes": {
          "type": "array",
          "description": "List of member names who disliked this message"
        }
      },
      "required": ["text", "author", "createdAt"]
    },
    "EmailPreference": {
      "title": "EmailPreference",
      "description": "Member notification delivery settings and opt-out preferences",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 200,
          "description": "User notification email address"
        },
        "optOutDailyDigest": {
          "type": "boolean",
          "description": "Whether user opted out of daily 6:00 AM watchlist dispatches"
        },
        "optOutWeeklyRoast": {
          "type": "boolean",
          "description": "Whether user opted out of weekly 7-day sarcastic recap newsletters"
        },
        "memberName": {
          "type": "string",
          "maxLength": 100,
          "description": "Associated member name"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp of last preference update"
        }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/movies/{movieId}": {
      "schema": "Movie",
      "description": "Collection of movies shared in the screening room"
    },
    "/hot_takes/{takeId}": {
      "schema": "HotTake",
      "description": "Weekly hot takes submitted by curators"
    },
    "/general_chat/{messageId}": {
      "schema": "ChatMessage",
      "description": "General banter and discussion stream"
    },
    "/email_preferences/{userId}": {
      "schema": "EmailPreference",
      "description": "Member email alert settings and opt-out statuses"
    }
  }
}
